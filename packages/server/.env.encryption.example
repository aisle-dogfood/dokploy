# Database Encryption Configuration
# 
# IMPORTANT: This encryption key is required to encrypt/decrypt sensitive data in the database
# 
# Generate a new key with: openssl rand -hex 32
# 
# CRITICAL SECURITY NOTES:
# - Keep this key secure and backed up separately from the database
# - Never commit this key to version control
# - Use a secrets management system in production (AWS Secrets Manager, HashiCorp Vault, etc.)
# - Loss of this key means permanent loss of all encrypted data
# - Rotate this key periodically (recommended: annually)

# Encryption key (64-character hex string)
ENCRYPTION_KEY=

# Example (DO NOT USE THIS - GENERATE YOUR OWN):
# ENCRYPTION_KEY=a1b2c3d4e5f67890abcdef1234567890abcdef1234567890abcdef1234567890
