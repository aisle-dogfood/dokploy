# The POSTGRES_PASSWORD is auto-generated during setup and stored in /etc/dokploy/.postgres-password
# You can override it by setting the POSTGRES_PASSWORD environment variable before running setup
# To retrieve the password: cat /etc/dokploy/.postgres-password
DATABASE_URL="postgres://dokploy:<POSTGRES_PASSWORD>@dokploy-postgres:5432/dokploy"
PORT=3000
NODE_ENV=production